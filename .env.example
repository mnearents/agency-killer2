# Database (Railway Postgres)
DATABASE_URL=postgresql://...
# The `query` MCP tool's own connection, as the claude_readonly role. It has
# SELECT on the analytics views and nothing else. Never point this at the
# owner credentials above — the whole PII exclusion depends on the role.
ANALYTICS_DATABASE_URL=postgresql://claude_readonly:...@.../railway

# Anthropic (all AI generation + vision)
ANTHROPIC_API_KEY=

# OpenAI (embeddings only)
OPENAI_API_KEY=

# Meta Marketing API + Instagram
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_...
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Shopify Admin API (GraphQL)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=

# Seal Subscriptions Merchant API (sent as the X-Seal-Token header)
SEAL_API_TOKEN=
# Optional override; defaults to https://app.sealsubscriptions.com/shopify/merchant/api
SEAL_BASE_URL=

# Dropbox (refresh token pattern)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_KB_ROOT=/RAD/Agency
# UNBUILT — video pipeline, deferred to #13. Read by nothing today, so
# deliberately absent from src/lib/env-manifest.ts.
DROPBOX_FOOTAGE_ROOT=/RAD/Footage
DROPBOX_RENDERS_ROOT=/RAD/Footage/renders

# AssemblyAI (transcription)
ASSEMBLYAI_API_KEY=

# Shotstack (video rendering)
# UNBUILT — video pipeline, deferred to #13. Read by nothing today, so
# deliberately absent from src/lib/env-manifest.ts.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Attentive (email/SMS events)
# PENDING — ingestion is a Playwright scraper and needs no key. This is for the
# write path in #23 (Bulk Operations v2 + SFTP segment upload), which is not
# built yet, so it is not in the manifest. Add it there when that ships.
ATTENTIVE_API_KEY=

# Slack (Bolt socket mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_REPORT_CHANNEL=C...  # Channel ID for proactive reports/alerts

# Voice API (Figma plugin)
VOICE_API_KEY=

# Blog automation
# DEAD — read by nothing. Despite the `false` below, blog generation runs every
# Tuesday 16:00 UTC: `blog-generate` is `enabled: true` in
# src/worker/tasks/registry.ts and its handler is gated only on
# ANTHROPIC_API_KEY. The real switch is that `enabled` flag. See #38.
BLOG_AUTOMATION_ENABLED=false
