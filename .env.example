# Database (Railway Postgres)
DATABASE_URL=postgresql://...
# The `query` MCP tool's own connection, as the claude_readonly role. It has
# SELECT on the analytics views and nothing else. Never point this at the
# owner credentials above — the whole PII exclusion depends on the role.
ANALYTICS_DATABASE_URL=postgresql://claude_readonly:...@.../railway

# Anthropic (all AI generation + vision)
ANTHROPIC_API_KEY=

# OpenAI (embeddings only)
OPENAI_API_KEY=

# Meta Marketing API + Instagram
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_...
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Shopify Admin API (GraphQL)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=

# Seal Subscriptions Merchant API (sent as the X-Seal-Token header)
SEAL_API_TOKEN=
# Optional override; defaults to https://app.sealsubscriptions.com/shopify/merchant/api
SEAL_BASE_URL=

# Dropbox (refresh token pattern)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_KB_ROOT=/RAD/Agency
# Raw video and audio. Transcribed and tagged into the knowledge base (#13).
DROPBOX_FOOTAGE_ROOT=/RAD/Footage

# AssemblyAI (transcription)
ASSEMBLYAI_API_KEY=

# Google Search Console (service account, read-only)
# The whole downloaded JSON key, on one line. The service account's email must
# be added as a user on the Search Console property itself — a valid key with
# no property access returns 200 and an empty site list.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Must match the property's form EXACTLY. A Domain property is
# `sc-domain:radandhappy.com`; a URL-prefix property is `https://radandhappy.com/`.
GSC_SITE_URL=

# Attentive
# The REST API key (api.attentivemobile.com) — segment push and subscriber
# eligibility. It carries no reporting endpoints; those are scraped.
# Cost entry form (/costs) — the one write surface on the dashboard.
# Both must be set or the form refuses every request; it fails closed so an
# unset variable cannot leave a write surface that still looks protected.
COST_FORM_USER=
COST_FORM_PASSWORD=

ATTENTIVE_API_KEY=
# UI credentials for the Playwright report scraper. 2FA codes are requested
# over Slack, so SLACK_BOT_TOKEN must be set for an unattended login to work.
ATTENTIVE_AGENT_USERNAME=
ATTENTIVE_AGENT_PASSWORD=

# Slack (Bolt socket mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_REPORT_CHANNEL=C...  # Channel ID for proactive reports/alerts

# Voice API (Figma plugin)
VOICE_API_KEY=

# Blog automation has no environment switch. It is governed solely by
# `enabled` on the `blog-generate` task in src/worker/tasks/registry.ts.
#
# BLOG_AUTOMATION_ENABLED used to live here set to `false`, was read by no
# code at all, and so told anyone who looked that blog automation was off
# while it ran every Tuesday (#38). A second switch that has to agree with
# the first is a liability, not a safety net — removed rather than wired up.
